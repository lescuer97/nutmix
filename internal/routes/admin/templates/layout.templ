package templates

templ head() {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<link rel="stylesheet" type="text/css" href="/css/app.css"/>
		<link rel="stylesheet" type="text/css" href="/css/summary.css"/>
		<script type="text/javascript" src="/js/index.js"></script>
	</head>
}

templ LayoutErrorToShow(message string) {
	if message != "" {
		<div class="ldk-outage-banner" role="alert">
			<span class="ldk-outage-banner-icon">⚠</span>
			<div class="ldk-outage-banner-content">
				<strong>LDK node is not running — minting and melting are offline.</strong>
				<span class="ldk-outage-banner-detail">{ message }</span>
			</div>
			<a href="/admin/settings" class="ldk-outage-banner-link">Fix in settings →</a>
		</div>
	}
}

templ Layout(route string, backendEndOfLife bool, showLDKNodeLink bool, layoutErrorToShow string) {
	<!DOCTYPE html>
	<html lang="en">
		@head()
		@Header(showLDKNodeLink)
		<body data-route={ route }>
			@LayoutErrorToShow(layoutErrorToShow)
			<div hx-ext="remove-me" id="notifications"></div>
			if backendEndOfLife {
				<aside id="backend-end-of-life-alert" class="deprecation-notice main-content" role="alert" aria-labelledby="backend-end-of-life-title">
					<div class="deprecation-header">
						<div class="deprecation-title-row">
							<span class="deprecation-badge">End of life</span>
							<span id="backend-end-of-life-title" class="deprecation-title">Strike backend stopped</span>
						</div>
					</div>
					<p class="deprecation-copy">Strike support has ended. Minting and Lightning payments are unavailable until you select another Lightning backend.</p>
				</aside>
			}
			{ children... }
		</body>
	</html>
}
